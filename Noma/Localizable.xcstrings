    },
    "auth.apple.button.title" : {
      "comment" : "Primary Apple SSO authentication button title.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit Apple anmelden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sign in with Apple"
          }
        }
      }
    },
    "auth.delete-account.additional-local-data-cleanup-error" : {
      "comment" : "Additional error detail shown when account deletion was not completed cleanly and local task data also could not be removed.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zusätzlich konnten die lokalen Aufgaben und Projekte nicht von diesem Gerät entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In addition, local tasks and projects could not be removed from this device."
          }
        }
      }
    },
    "auth.delete-account.alert.message" : {
      "comment" : "Confirmation message before permanently deleting a signed-in account.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Account wird dauerhaft gelöscht. Lokal gespeicherte Aufgaben und Projekte für diesen Account werden von diesem Gerät entfernt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account will be permanently deleted. Locally stored tasks and projects for this account will be removed from this device."
          }
        }
      }
    },
    "auth.delete-account.alert.title" : {
      "comment" : "Confirmation alert title before permanently deleting a signed-in account.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account löschen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account?"
          }
        }
      }
    },
    "auth.delete-account.confirm" : {
      "comment" : "Destructive confirmation button for account deletion.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account löschen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delete account"
          }
        }
      }
    },
    "auth.delete-account.error.title" : {
      "comment" : "Alert title shown when account deletion fails.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Account konnte nicht gelöscht werden"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not delete account"
          }
        }
      }
    },
    "auth.delete-account.local-data-cleanup-error" : {
      "comment" : "Error shown when the remote account was deleted but its local task data could not be removed from the device.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Account wurde gelöscht, aber die lokalen Aufgaben und Projekte konnten nicht von diesem Gerät entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The account was deleted, but its local tasks and projects could not be removed from this device."
          }
        }
      }
    },
    "auth.delete-account.missing-local-data-scope-error" : {
      "comment" : "Error shown when account deletion cannot safely identify the signed-in user's local data scope.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der lokale Datenbereich dieses Accounts konnte nicht sicher ermittelt werden. Bitte melde dich ab und erneut an, bevor du den Account löschst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The local data scope for this account could not be identified safely. Sign out and back in before deleting the account."
          }
        }
      }
    },
    "auth.delete-account.pending-local-data-cleanup-error" : {
      "comment" : "Error shown after launch recovery could not remove local data left by an interrupted account-deletion flow.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausstehende lokale Bereinigung nach der Accountlöschung konnte noch nicht abgeschlossen werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The pending local cleanup after account deletion could not be completed yet."
          }
        }
      }
    },
